<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>dcbypass</AssemblyName>
    <RootNamespace>dcbypass</RootNamespace>
    <AssemblyTitle>DC Bypass - Zero Lag DPI Unblocker</AssemblyTitle>
    <Product>DC Bypass Pro</Product>
    <Version>1.0.0</Version>
    <Authors>DCBypass</Authors>
  </PropertyGroup>

  <ItemGroup>
    <None Update="core_engine\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
